# Copy to .env and fill in. Never commit .env.

# Optional: without a key the app uses a rule-based summary instead of an LLM.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Used by docker-compose for the PostgreSQL container.
POSTGRES_USER=aidme
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aidme

# Local (non-Docker) run. docker-compose overrides these.
DATABASE_URL=sqlite:///./aidme.db
DATA_DIR=./data
MAX_UPLOAD_MB=50
API_URL=http://localhost:8000
